.git
.venv
.hood
.hood-live
node_modules
**/__pycache__
**/*.pyc
.claude
release/evidence/live/*.zip
artifacts/*.db
artifacts/*.enc
artifacts/*.json
*.log
.pytest_cache
# Secrets never enter the image; compose injects them at run time.
.env
.env.*
!env.example
# The passwordless package helper and its sudoers installer never ship in the image
# (security batch 1); Windows/WSL helper scripts are irrelevant on the server.
scripts/wsl/
scripts/windows/
# Nothing from the build machine's own HOOD data may enter the image (security batch 1 review):
# old stores in artifacts/ (incl. the vault key), logs and setup codes.
artifacts/
**/.vault_key
**/.receipt_key
**/.token_key
**/*.log
**/owner_setup_code.txt
