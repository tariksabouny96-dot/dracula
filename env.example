# Copy to .env in the repo root (never commit); `python hood_cli.py ...` loads it on
# start. Real environment variables always win. Every variable is optional unless noted.

# Where Hood keeps runtime data (auth, agent missions, conversations, stop latch).
HOOD_DATA_DIR=~/.hood

# Extra Host header values accepted (comma-separated), only when behind a reverse proxy.
HOOD_ALLOWED_HOSTS=

# Secrets: prefer your OS secret store / service manager to inject these.
HOOD_VAULT_KEY=            # Fernet key for artifacts/vault.enc (else a 0600 key file is created)
HOOD_RECEIPT_KEY=          # HMAC key for agent receipts (else a 0600 key file is created)

# Model providers. A provider call is REFUSED unless its model has a price on file
# (no unknown-cost calls). Both lines below are needed for live chat/agents.
# The shipped file declares $0 for a free-tier key with NO billing account; if
# billing is enabled on your Google project, put the real prices in it first.
HOOD_MODEL_PRICING=config/model_pricing.free-tier.json
GEMINI_API_KEY=
# Optional model overrides; leave blank for the defaults (gemini-3.8-flash /
# gemini-3.5-flash-lite). gemini-2.5-* returns 404 for new API keys. Any model
# you set must also be priced in HOOD_MODEL_PRICING.
HOOD_GEMINI_STANDARD_MODEL=
OPENAI_API_KEY=
HOOD_ALLOW_OPENAI_API_CALLS=0
HOOD_OPENAI_STANDARD_MODEL=

# Browser automation: path to a Chromium binary if Playwright's own build is absent
HOOD_CHROMIUM_EXECUTABLE=

# Test profiles (leave 0 unless you have written approval and a spend cap)
HOOD_RUN_LIVE_PROVIDER=0
HOOD_RUN_LIVE_NETWORK=0
