# Copy to .env in the repo root (never commit); `python hood_cli.py ...` loads it on
# start. Real environment variables always win. Every variable is optional unless noted.

# Where Hood keeps runtime data (auth, agent missions, conversations, stop latch).
HOOD_DATA_DIR=~/.hood

# Extra Host header values accepted (comma-separated), only when behind a reverse proxy.
HOOD_ALLOWED_HOSTS=

# Secrets: prefer your OS secret store / service manager to inject these.
HOOD_VAULT_KEY=            # Fernet key for artifacts/vault.enc (else a 0600 key file is created)
HOOD_RECEIPT_KEY=          # HMAC key for agent receipts (else a 0600 key file is created)

# Model providers. A provider call is REFUSED unless its model has a price on file
# (no unknown-cost calls). Both lines below are needed for live chat/agents.
# The shipped file declares $0 for a free-tier key with NO billing account; if
# billing is enabled on your Google project, put the real prices in it first.
HOOD_MODEL_PRICING=config/model_pricing.free-tier.json
GEMINI_API_KEY=
# Optional model overrides; leave blank for the defaults (gemini-3.8-flash /
# gemini-3.5-flash-lite). gemini-2.5-* returns 404 for new API keys. Any model
# you set must also be priced in HOOD_MODEL_PRICING.
HOOD_GEMINI_STANDARD_MODEL=
OPENAI_API_KEY=
HOOD_ALLOW_OPENAI_API_CALLS=0
HOOD_OPENAI_STANDARD_MODEL=

# Browser automation: path to a Chromium binary if Playwright's own build is absent
HOOD_CHROMIUM_EXECUTABLE=

# Test profiles (leave 0 unless you have written approval and a spend cap)
HOOD_RUN_LIVE_PROVIDER=0
HOOD_RUN_LIVE_NETWORK=0

# ---------------------------------------------------------------------------------------------------------------
# Voice calling (iPhone <-> Hood). Everything below is OFF until HOOD_VOICECALL_ENABLED=1. See docs/VOICE_SETUP.md.
# Check your setup (offline, spends nothing):  python hood_cli.py voicecall doctor
# Any secret can be given as NAME_FILE=/path/to/file instead of NAME=value (preferred: the file is chmod 600).
# ---------------------------------------------------------------------------------------------------------------
HOOD_VOICECALL_ENABLED=0

# LiveKit (the voice transport). A free LiveKit Cloud project works to start with; LIVEKIT_API_SECRET never
# leaves the Hood host. The worker process needs the same three values.
LIVEKIT_URL=                    # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=             # or LIVEKIT_API_SECRET_FILE=/secure/path

# Apple push (needed only so HOOD can RING the phone; the phone can always call Hood without it).
APNS_TEAM_ID=                   # 10 characters, Apple Developer > Membership
APNS_KEY_ID=                    # 10 characters, the .p8 key's id (Apple Developer > Keys > Apple Push Notifications)
APNS_KEY_PATH=                  # path to AuthKey_XXXXXXXXXX.p8 (chmod 600)
APNS_BUNDLE_ID=                 # the app's bundle id, e.g. com.yourname.hoodvoice (VoIP topic = <bundle id>.voip)
APNS_SANDBOX=1                  # 1 = apps installed from Xcode; 0 = TestFlight / App Store

# Who answers: gemini-live (default; realtime), gemini-cascade (speech-to-text -> Hood -> text-to-speech),
# openai-realtime (disabled unless you opt in; needs its own key and approval).
HOOD_VOICECALL_PROVIDER=gemini-live
HOOD_VOICECALL_LANGUAGE=en      # en | fr | ar | ar-MA (ar and ar-MA are untested)

# Spending and call limits. The phone's Settings screen can only set these LOWER, never higher.
HOOD_VOICECALL_PER_CALL_USD=1.0
HOOD_VOICECALL_DAILY_USD=3.0
HOOD_VOICECALL_MONTHLY_USD=15.0
HOOD_VOICECALL_DAILY_MINUTES=60
HOOD_VOICECALL_MONTHLY_MINUTES=300
HOOD_VOICECALL_MAX_SECONDS=900
HOOD_VOICECALL_MAX_CALLS_PER_HOUR=3     # Hood-initiated rings per hour
HOOD_VOICECALL_QUIET_START=22:00
HOOD_VOICECALL_QUIET_END=07:00
HOOD_VOICECALL_TZ=Europe/Paris          # an IANA name, e.g. Africa/Casablanca

# Optional: a long random value for per-call worker credentials. Leave empty to have Hood create and keep a
# private one (0600) in HOOD_DATA_DIR/voicecall. If you set it, it must be 32+ characters.
HOOD_VOICECALL_AGENT_SECRET=

# --- the VOICE WORKER process only (python -m voice_agent.worker start) -------------------------------------------
# Same LIVEKIT_* as above, plus:
HOOD_API_URL=http://127.0.0.1:8990      # where the worker reaches Hood: keep it on a private network
GOOGLE_API_KEY=                 # Gemini key for realtime mode (or GEMINI_API_KEY / *_FILE). Not needed on the Hood host
                                # unless the worker runs there. Check Google's data-use terms for your tier first.
